    "normalize_function_source": "def normalize(value):\n    \"\"\"Only the prior policy's exact owned roots and incidental tokens vary.\"\"\"\n    # Only the observed current readonly fopen role gains a nineteen-character suffix.\n    readonly_key = hashlib.sha1(b'overwrite-read-only').hexdigest()\n    value = re.sub(re.escape(NEW + '/tmp')\n                   + r'/low-list-tests-[a-zA-Z0-9]{19}(?=/low_list/' + readonly_key + r'\\))',\n                   '<OWNED_CACHE>', value)\n    for root in (OLD, NEW):\n        for prefix in (root + '/snapshot', 'phar://' + root + '/snapshot',\n                       'include_once(' + root + '/snapshot', root + '/tmp'):\n            value = value.replace(prefix[:15] + '...', '<OWNED_PATH_PREVIEW>')\n        value = value.replace(root + '/snapshot', '<ROOT>')\n        value = re.sub(re.escape(root + '/tmp') + r'/low-list-tests-[a-zA-Z0-9]{6}',\n                       '<OWNED_CACHE>', value)\n    value = re.sub(r'(?<=/low-list-updater-)[a-f0-9]{16}(?=/)', '<UPDATER_NONCE>', value)\n    return re.sub(r'(?<=Object &)[0-9a-f]{32}\\b', '<INCIDENTAL_OBJECT_ID>', value)",
    "recursive_policy": "Only testcase time excluded. Every other attribute/tag/text/tail/nested child exact after literal normalization. Named reverse/random additionally ignore only proven whitespace-only structural testcase tail, never any issue tail.",
    "new_role": "Exactly current NEW/tmp/low-list-tests-19 ASCII alphanumeric followed by /low_list/sha1(overwrite-read-only)) only; historical6 unchanged. Wrong source/line/class/message/foreign paths do not match."
  },
